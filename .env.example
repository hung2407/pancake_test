# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Local HTTP & Socket.io port (default 3000 -> http://localhost:3000)
PORT="3000"

# WEBHOOK_VERIFY_TOKEN: Token used to verify Meta / Facebook / Instagram GET webhook challenges
WEBHOOK_VERIFY_TOKEN="dauto_verify_2026"

# --- BOT LOCAL INTEGRATION (Optional - see candien.md) ---
BOT_API_KEY=""
OUTBOUND_BOT_WEBHOOK_URL=""

# --- META / FACEBOOK / INSTAGRAM (Optional - see candien.md) ---
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""

# --- ZALO OA (Optional - see candien.md) ---
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_REFRESH_TOKEN=""
ZALO_REDIRECT_URI=""

# --- TIKTOK SHOP & SHOPEE (Optional - see candien.md) ---
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_API_HOST=""

# --- SHIPPING CARRIERS (Optional - see candien.md) ---
GHN_TOKEN=""
GHN_SHOP_ID=""
GHN_FROM_DISTRICT_ID=""
GHN_FROM_WARD_CODE=""
GHTK_TOKEN=""
GHTK_PICK_NAME=""
GHTK_PICK_ADDRESS=""
GHTK_PICK_PROVINCE=""
GHTK_PICK_DISTRICT=""
GHTK_PICK_TEL=""
VIETTEL_POST_TOKEN=""
VTP_GROUPADDRESS_ID=""
JT_API_KEY=""
JT_EC_COMPANY_ID=""
JT_ORDER_URL=""
